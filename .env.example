# ==============================================================================
# AF Care Companion (CDSS) - Environment Configuration Example
# Copy this file to '.env' and populate with your project credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase public/anonymous API key used for authenticated client-side requests
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key_here"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key_here"

# Supabase project reference ID
SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PROJECT_ID="your_project_id"

# Supabase service role key for administrative server-side operations (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_your_secret_key_here"

# ------------------------------------------------------------------------------
# 2. CDSS Clinical Engine & EMR Adapter Settings
# ------------------------------------------------------------------------------
# EMR normalizer adapter to use ("mock" loads local benchmark/hospital JSONs; "custom" for hospital HL7/FHIR feeds)
CDSS_EMR_ADAPTER="mock"

# Optional bearer authentication token for securing the standalone '/api/cdss/analyze' REST endpoint
CDSS_API_TOKEN=""

# Base URL for external CDSS inference service (Leave empty to use same-origin TanStack server functions)
VITE_CDSS_API_URL=""

# Persist clinician input drafts in browser localStorage (0 = disabled for hospital PHI compliance; 1 = enabled)
VITE_CDSS_PERSIST_DRAFTS="0"

# ------------------------------------------------------------------------------
# 3. Scheduled Tasks & Automation
# ------------------------------------------------------------------------------
# Secret token used to authenticate automated maintenance & audit log archiving cron jobs
LOVABLE_CRON_SECRET=""
